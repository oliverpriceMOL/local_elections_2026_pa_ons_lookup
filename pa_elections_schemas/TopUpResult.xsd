<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" attributeFormDefault="unqualified"
           xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="DataTypes.xsd"/>
  <xs:complexType name="Candidate">
    <xs:sequence>
      <xs:element name="Party" type="Party" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="paId" type="xs:int" use="required"/>
    <xs:attribute name="elected" type="SittingMember" use="optional"/>
    <xs:attribute name="previousSittingMember" type="SittingMember" use="optional"/>
    <xs:attribute name="sex" type="SexOfCandidate" use="optional"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="firstName" type="xs:string" use="optional"/>
    <xs:attribute name="surname" type="xs:string" use="required"/>
		<xs:attribute name="ballotName" type="xs:string" use="optional"/>
    <xs:attribute name="partyListRank" type="PartyListRank" use="optional"/>
  </xs:complexType>
  <!-- A party as it occurs inside a Candidate element, where only
         the core details of the party are necessary. -->
  <xs:complexType name="Party">
    <xs:attribute name="paId" type="xs:int" use="required"/>
    <xs:attribute name="abbreviation" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
  <!-- A party as it occurs inside a Constituency element, where it
         has votes, percentage shares etc. associated with it, representing
         the votes which were cast for a party in a top-up constituency. -->
  <xs:complexType name="PartyWithResults">
    <xs:attribute name="paId" type="xs:int" use="required"/>
    <xs:attribute name="abbreviation" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="votes" type="xs:int" use="required"/>
    <xs:attribute name="percentageShare" type="Percentage" use="required"/>
    <xs:attribute name="percentageShareChange" type="Percentage" use="optional"/>
    <xs:attribute name="candidatesElected" type="xs:integer" use="optional"/>
  </xs:complexType>
  <!--
The bulk of the overall constituency results are represented as
attributes to the Constituency element.  The individual Party results
and Candidate details are contained within the Constituency element.
    -->
  <xs:complexType name="Constituency">
    <xs:sequence>
      <xs:element name="Candidate" type="Candidate" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Party" type="PartyWithResults" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="number" type="xs:integer" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="electorate" type="xs:integer" use="optional"/>
    <xs:attribute name="turnout" type="xs:integer" use="required"/>
    <xs:attribute name="percentageTurnout" type="Percentage" use="required"/>
    <xs:attribute name="percentageChangeTurnout" type="Percentage" use="optional"/>
    <xs:attribute name="winningParty" type="xs:string" use="required"/>
    <xs:attribute name="majority" type="xs:integer" use="required"/>
    <xs:attribute name="percentageMajority" type="Percentage" use="required"/>
    <xs:attribute name="percentageChangeMajority" type="Percentage" use="optional"/>
    <xs:attribute name="swing" type="Percentage" use="optional"/>
    <xs:attribute name="swingTo" type="xs:string" use="optional"/>
    <xs:attribute name="swingFrom" type="xs:string" use="optional"/>
  </xs:complexType>
  <!--
Notional results in a previous election in a constituency which has
undergone a boundary change are represented using the special
NotionalConstituency element.  Individual Party results are contained
within.
    -->
  <xs:complexType name="NotionalConstituency">
    <xs:sequence>
      <xs:element name="Party" type="PartyWithResults" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="number" type="xs:integer" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="electorate" type="xs:integer" use="optional"/>
    <xs:attribute name="turnout" type="xs:integer" use="required"/>
    <xs:attribute name="percentageTurnout" type="Percentage" use="required"/>
    <xs:attribute name="winningParty" type="xs:string" use="required"/>
    <xs:attribute name="majority" type="xs:integer" use="required"/>
    <xs:attribute name="percentageMajority" type="Percentage" use="required"/>
    <xs:attribute name="percentageChangeMajority" type="Percentage" use="optional"/>
    <xs:attribute name="swing" type="Percentage" use="optional"/>
    <xs:attribute name="swingTo" type="xs:string" use="optional"/>
    <xs:attribute name="swingFrom" type="xs:string" use="optional"/>
  </xs:complexType>
  <!--
A summary of the results of a previous election contsists of a Constituency
element, which contains the previous party results and candidates elected,
together with some attributes pertaining to the election itself.
    -->
  <xs:complexType name="TopUpSummary">
    <xs:sequence>
      <xs:element name="Constituency" type="Constituency" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="ElectionType" use="required"/>
    <xs:attribute name="date" type="xs:date" use="required"/>
  </xs:complexType>
  <!--
A summary of the results of a previous notional election in a
constituency which has undergone a boundary change contsists of a
Constituency element, which contains the previous notional results per
party and the numbers of candidates notionally elected, together with
some attributes pertaining to the election itself.
    -->
  <xs:complexType name="TopUpNotionalSummary">
    <xs:sequence>
      <xs:element name="Constituency" type="NotionalConstituency" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="type" type="ElectionType" use="required"/>
    <xs:attribute name="date" type="xs:date" use="required"/>
  </xs:complexType>
  <!--
This is the root element.  It contains an Election element, with the
results for the constituency in the current election, followed by an
optional PreviousElection or PreviousNotionalElection element,
containing the results for the same or equivalent constituency in a
previous associat election.
    -->
  <xs:element name="TopUpResult">
    <xs:annotation>
      <xs:documentation>Single result in a top-up constituency</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Election">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Constituency" type="Constituency"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="date" type="xs:date"/>
            <xs:attribute name="type" type="ElectionType"/>
          </xs:complexType>
        </xs:element>
        <xs:choice>
          <xs:element name="PreviousElection" type="TopUpSummary" minOccurs="0" maxOccurs="1"/>
          <xs:element name="PreviousNotionalElection" type="TopUpNotionalSummary" minOccurs="0" maxOccurs="1"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="revision" type="xs:integer" use="optional"/>
      <xs:attribute name="declarationTime" type="xs:dateTime" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
